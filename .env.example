# Sentinel PayFlow — Environment Configuration (Copy to .env)
# Strictly non-custodial: NO wallet private keys are ever stored in this service.

# Environment: "devnet" or "mainnet"
MULTIHOPPER_ENV=devnet

# Obtain from https://devnet.multihopper.com/developer/dashboard (mh_test_...)
# or https://multihopper.com/developer/dashboard (mh_live_...)
MULTIHOPPER_API_KEY=

# 16-byte Integrator Provider ID for 0.25% MultiHopper Revenue Share tracking
SENTINEL_PROVIDER_ID=SENTINELPAYFLOW1

# Public Base58 Solana Treasury Receiver for Gateway Structuring Fees
SENTINEL_SOLANA_TREASURY=9xQeWvG816bUx9EPjHmaT23yvVM2ZWbrrpZb9PusVFin

# Gateway Fee (in basis points; 50 = 0.50%) & Single-Batch Outflow Breaker (USD)
SENTINEL_GATEWAY_FEE_BPS=50
MAX_SINGLE_ROUTE_USD=500000.00
